{
    "name": "cencori/cencori-php",
    "description": "Official PHP SDK for Cencori v1.2.1 - AI Infrastructure for Production. AI Gateway, Agents, Memory, Compute, Workflow, Storage.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ai",
        "llm",
        "openai",
        "anthropic",
        "gemini",
        "api",
        "gateway",
        "infrastructure",
        "agents",
        "memory",
        "rag"
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/psr7": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Cencori\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cencori\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "FohnAI",
            "email": "support@cencori.com"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "1.2.x-dev"
        }
    }
}
