{
    "name": "cencori/cencori-php",
    "description": "Official PHP SDK for Cencori v1.4.0 - AI Infrastructure for Production. AI Gateway, Vision, Documents, Agents, Memory, Compute, Workflow, Storage.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://cencori.com",
    "readme": "README.md",
    "keywords": [
        "ai",
        "llm",
        "openai",
        "anthropic",
        "gemini",
        "api",
        "gateway",
        "infrastructure",
        "agents",
        "memory",
        "rag"
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/psr7": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Cencori\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cencori\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "FohnAI",
            "email": "support@cencori.com"
        }
    ],
    "support": {
        "issues": "https://github.com/cencori/cencori-php-sdk/issues",
        "source": "https://github.com/cencori/cencori-php-sdk",
        "docs": "https://cencori.com/docs"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.4.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
